# Brain Town E2E — local target only. Copied to env/.env.local (git-ignored) by `npm run env:init`,
# which also replaces every __FROM_PASSWORD_MANAGER__ with a random value for this machine.
# The same file is passed to `docker compose --env-file` by scripts/stack.sh, so the suite and the
# stack share the admin account and the ingest limits. Never put demo or production values here.

# ── Suite ──────────────────────────────────────────────────────────────────────
BRAIN_TOWN_URL=http://127.0.0.1:18280
# Optional; defaults to ${BRAIN_TOWN_URL}/events
SSE_EVENTS_URL=
FEED_FIXTURE_URL=https://feed-fixture:8443
PROTECTED_HOSTS=town.mfardiansyah.id,town.demo.mfardiansyah.id
BROWSERS=chromium

# ── Shared by the suite and the stack ─────────────────────────────────────────
ADMIN_EMAIL=admin@brain-town.test
ADMIN_PASSWORD=__FROM_PASSWORD_MANAGER__
# Low limits so the rate-limit spec is a bounded burst. perf:local raises them for its own stack.
INGEST_RATE=5
INGEST_BURST=20

# ── Stack only (read by docker compose, project brain-town-e2e) ───────────────
PORT=18280
BIND_ADDR=127.0.0.1
# Also tags the images brain-town-{web,api}:e2e, so local/demo images are not overwritten.
BRAIN_TOWN_MODE=e2e
PUBLIC_URL=http://127.0.0.1:18280
# The web service gets no env file (only the api reads credentials).
ENV_FILE=e2e/.stack/web.env
ARCADEDB_URL=http://arcadedb:2480
ARCADEDB_DATABASE=braintown_e2e
ARCADEDB_USER=root
ARCADEDB_PASSWORD=__FROM_PASSWORD_MANAGER__
FEED_PULL_INTERVAL_SECONDS=2
