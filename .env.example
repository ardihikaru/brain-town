# Copy to .env (local), or .env.demo / .env.prod on a server. Never commit the real files.

# demo = simulated events only; prod = the real deployment.
BRAIN_TOWN_MODE=demo
PUBLIC_URL=http://127.0.0.1:8080

# Host address and port the container is published on (compose reads these).
BIND_ADDR=127.0.0.1
PORT=8080

# Back-office admin login. Server-side only; never ship these to the browser.
ADMIN_EMAIL=admin@example.com
# Required: compose refuses to start while this is empty. Generate one: openssl rand -base64 24
ADMIN_PASSWORD=

# ArcadeDB (graph store for events, integrations and the back-office).
# Not read yet: the API keeps data in a JSON snapshot (volume api-data) until the ArcadeDB
# adapter lands. Set in production so the adapter only has to be dropped in.
ARCADEDB_URL=http://127.0.0.1:2480
ARCADEDB_DATABASE=braintown
ARCADEDB_USER=braintown
ARCADEDB_PASSWORD=change-me
