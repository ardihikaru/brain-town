# Copy to .env (local), or .env.demo / .env.prod on a server. Never commit the real files.

# demo = simulated events only; prod = the real deployment.
BRAIN_TOWN_MODE=demo
PUBLIC_URL=http://127.0.0.1:8080

# Host address and port the container is published on (compose reads these).
BIND_ADDR=127.0.0.1
PORT=8080

# Back-office admin login. Server-side only; never ship these to the browser.
ADMIN_EMAIL=me@mfardiansyah.id
# Required: compose refuses to start while this is empty. Generate one: openssl rand -base64 24
ADMIN_PASSWORD=

# Per-integration ingest limit (token bucket): sustained events/s and burst size.
# Over it, the API answers 429 + Retry-After and senders retry (see docs/integrations).
INGEST_RATE=50
INGEST_BURST=200

# ArcadeDB (graph store for integrations, products and events). The api creates the database
# and its schema on first start if the user may; otherwise create `braintown` first.
# Required when BRAIN_TOWN_MODE=prod. Empty means memory only (events lost on restart).
#
# Local: `docker compose --profile db up --build` runs ArcadeDB for you. Use the values below
# (the api reaches it by service name; the user is root and the password is its root password).
# Production: point ARCADEDB_URL at the existing server as seen FROM THE CONTAINER (not 127.0.0.1,
# which is the container itself) and use the dedicated `braintown` user.
ARCADEDB_URL=http://arcadedb:2480
ARCADEDB_DATABASE=braintown
ARCADEDB_USER=root
ARCADEDB_PASSWORD=change-me

# Site JSON Feed pull interval in seconds (default 300)
FEED_PULL_INTERVAL_SECONDS=300
